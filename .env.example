# .env.example
SECRET_KEY=Key
ENV=development
ALLOWED_ORIGINS=["http://localhost"]
CLOUDFLARE_TUNNEL_TOKEN=Token

# --- Broker credential encryption (REQUIRED to link any brokerage) ---
# Alpaca API keys are stored encrypted in SQLite with this key. Without it the
# app refuses to store credentials at all rather than falling back to plaintext.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this SEPARATE from SECRET_KEY: rotating it orphans every linked account.
BROKER_ENCRYPTION_KEY=

# --- Live trading gates (all default to off) ---
# Server-wide switch for real-money orders. Leave false for paper-only.
ALLOW_LIVE_TRADING=false
# Allows the autonomous RL bot to place LIVE orders. Requires ALLOW_LIVE_TRADING
# as well. Keep this false until the model's action distribution is validated —
# manual trades are unaffected by it.
ALLOW_LIVE_BOT_TRADING=false

# --- Order fill polling (optional) ---
# How long to wait for a market order to settle before recording it as PENDING
# and leaving it to the reconciler.
BROKER_FILL_POLL_TIMEOUT=8
BROKER_FILL_POLL_INTERVAL=0.75
